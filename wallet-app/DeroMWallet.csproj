<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>DeroMWallet</AssemblyName>
    <RootNamespace>DeroMWallet</RootNamespace>
    <!-- The GitHub release for this wallet is versioned independently of the
         node (package.json), so the executable carries its own version. -->
    <Version>1.0.0</Version>
    <AssemblyVersion>1.0.0.0</AssemblyVersion>
    <FileVersion>1.0.0.0</FileVersion>
    <InformationalVersion>1.0.0</InformationalVersion>
    <Product>DeroM Wallet</Product>
    <Description>Windows desktop wallet for the DeroM development chain</Description>
    <Copyright>Public domain (Unlicense)</Copyright>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
  </PropertyGroup>

</Project>
